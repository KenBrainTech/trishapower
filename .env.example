# ---- Website form (build-time, read by the browser bundle) ----
# Leave empty: forms hand the enquiry off to WhatsApp / email (nothing is "sent" silently).
# On Vercel with the built-in function: set to /api/inquiry
# Or any other HTTPS endpoint that accepts a JSON POST (Formspree, Getform, your own API...).
VITE_INQUIRY_ENDPOINT=

# ---- Vercel function api/inquiry.ts (server-side only, never exposed to the browser) ----
RESEND_API_KEY=
INQUIRY_TO_EMAIL=sales.trishapower@gmail.com
INQUIRY_FROM_EMAIL="Trisha Power Website <website@trishapower.in>"
